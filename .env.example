# Copy to .env (which git ignores) and fill in.
# Everything explained – where to get the keys, what's required and what it costs: docs/configuration.md
#
# REQUIRED: PLUGGIS_ADMIN_PASSWORD (the first time) and at least one way to run Claude (below).
# Choose ONE way to run Claude:
# 1) API key (pay per token, console.anthropic.com):
ANTHROPIC_API_KEY=
# 2) Your Claude subscription via Claude Code: run "claude setup-token" on your computer and paste the token.
#    Leave ANTHROPIC_API_KEY empty.
# PLUGGIS_CLAUDE_BACKEND=claude-code
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# 3) Hybrid: the voice (coach) via the API key, photos/plans/flashcards/material via the subscription.
#    Fill in BOTH ANTHROPIC_API_KEY and CLAUDE_CODE_OAUTH_TOKEN. If the subscription fails the API key is used.
# PLUGGIS_CLAUDE_BACKEND=hybrid
# PLUGGIS_CLAUDE_API_PURPOSES=coach
# Password for the parent view (/admin), at least 8 characters. Set when the server starts and stored hashed –
# the line can be removed afterwards. Forgot the password: write a new one here and restart.
# The student and the Tab5 log in with the student's code (parent view → System → Students).
PLUGGIS_ADMIN_PASSWORD=change-me
# Models per job (default: Haiku 5.5 for the voice coach, Sonnet 5.5 for the rest)
# PLUGGIS_COACH_MODEL=claude-haiku-5-5
# PLUGGIS_COACH_EFFORT=low
# PLUGGIS_COACH_THINKING=disabled
# PLUGGIS_VISION_MODEL=claude-sonnet-5-5
# PLUGGIS_PLANNING_MODEL=claude-sonnet-5-5
# PLUGGIS_EXAM_MODEL=claude-opus-5-5
# PLUGGIS_FLASHCARDS_MODEL=claude-sonnet-5-5
# PLUGGIS_CLAUDE_TIMEOUT=120
# Exchange rate for the cost tab
# PLUGGIS_USD_SEK=10.0
# Optional: Azure's neural voices (Swedish Sofie, Hillevi, Mattias, plus Spanish, German, French, English) for read-aloud.
# Create a Speech resource on the "Free F0" tier in the Azure portal – it can't cost anything.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=swedencentral
# Optional: Google Calendar – put the service account's JSON key in secrets/ (nothing needed here).
# Planning and points (defaults for new students; changed per student in admin)
# PLUGGIS_MAX_MINUTES_PER_DAY=40
# PLUGGIS_STUDY_DAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,SUNDAY
# PLUGGIS_REMINDERS_ENABLED=true
# PLUGGIS_REWARDS_ENABLED=true
# PLUGGIS_SEK_PER_POINT=0.10
# PLUGGIS_WEEKLY_CAP_SEK=50
# The speech service (speech/). Set automatically in docker-compose.
# PLUGGIS_SPEECH_URL=http://localhost:8090
# SPRING_PROFILES_ACTIVE=postgres
# DB_URL=jdbc:postgresql://localhost:5432/pluggis
# DB_USER=pluggis
# DB_PASSWORD=
